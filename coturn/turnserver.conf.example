listening-port=3478
tls-listening-port=5349

# Зовнішній IP сервера (публічний)
external-ip=YOUR_PUBLIC_IP

# Той самий секрет що в homeserver.yaml → turn_shared_secret
use-auth-secret
static-auth-secret=TURN_SECRET_HERE

realm=YOUR_DOMAIN

cert=/etc/letsencrypt/live/YOUR_DOMAIN/fullchain.pem
pkey=/etc/letsencrypt/live/YOUR_DOMAIN/privkey.pem

min-port=49152
max-port=65535

no-tcp-relay
# Дозволяємо офісну мережу
allowed-peer-ip=10.12.0.0-10.12.3.255
# Блокуємо решту приватних діапазонів
denied-peer-ip=10.0.0.0-10.255.255.255
denied-peer-ip=172.16.0.0-172.31.255.255
denied-peer-ip=192.168.0.0-192.168.255.255

log-file=/var/log/coturn/turnserver.log
simple-log
