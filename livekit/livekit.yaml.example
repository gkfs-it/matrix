port: 7880
rtc:
  tcp_port: 7881
  port_range_start: 50000
  port_range_end: 50100
  node_ip: YOUR_PUBLIC_IP

# Згенерувати: openssl rand -hex 16 (key), openssl rand -base64 32 (secret)
keys:
  LIVEKIT_API_KEY_HERE: LIVEKIT_API_SECRET_HERE

room:
  empty_timeout: 300
  departure_timeout: 20

logging:
  json: false
  level: info
